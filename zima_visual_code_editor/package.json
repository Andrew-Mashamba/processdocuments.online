{
  "name": "@zima/visual-code-editor",
  "version": "1.0.0",
  "description": "Visual code editor powered by Claude AI - Edit web applications directly from the browser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "visual-editor": "./bin/visual-editor"
  },
  "scripts": {
    "build": "tsc && npm run postbuild",
    "postbuild": "mkdir -p public && cp dist/frontend/injector.js public/injector.bundle.js",
    "build:frontend": "echo 'Frontend build skipped - injector included in dist'",
    "dev": "tsc -w",
    "start": "node dist/cli/start.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude",
    "ai",
    "visual-editor",
    "code-editor",
    "livewire",
    "react",
    "vue",
    "angular",
    "development-tools"
  ],
  "author": "ZIMA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zima/visual-code-editor.git"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1",
    "node-fetch": "^2.7.0",
    "fast-glob": "^3.3.2",
    "chokidar": "^3.6.0",
    "uuid": "^9.0.1",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.20",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/better-sqlite3": "^7.6.9",
    "@types/uuid": "^9.0.8",
    "@types/crypto-js": "^4.2.2",
    "@types/inquirer": "^8.2.10",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.2",
    "concurrently": "^8.2.2",
    "html2canvas": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "public",
    "bin",
    "README.md",
    "LICENSE"
  ]
}
